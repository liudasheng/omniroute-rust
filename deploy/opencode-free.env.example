# omniroute-rust 免费 lane（OpenCode Zen 匿名档）环境变量样例
#
# 所有值均为占位符 / 默认值示例，按需取消注释并替换。
#
# 用法一：systemd 用户服务（推荐；unit drop-in 见 deploy/README.md §9.2）
#   install -m 600 deploy/opencode-free.env.example "$HOME/.omniroute-rust/opencode-free.env"
#   $EDITOR "$HOME/.omniroute-rust/opencode-free.env"
#   # ~/.config/systemd/user/omniroute-rust.service.d/10-opencode-free.conf
#   # [Service]
#   # EnvironmentFile=-%h/.omniroute-rust/opencode-free.env
#
# 用法二：前台运行前手动加载
#   set -a; . ./deploy/opencode-free.env.example; set +a
#
# 格式（systemd EnvironmentFile）：每行 KEY=VALUE；整行注释以 # 开头；
# 不支持 shell 变量展开、命令替换或行内注释；不要给值加不必要的引号。
# 安全：本文件一旦含代理口令/密钥即属机密，必须 chmod 600，且不得提交仓库。

# ---------------------------------------------------------------------------
# 凭据模式
# ---------------------------------------------------------------------------
# auto（默认）：轮询托管 opencode / opencode-zen 账号并各用其 key；
#               账号池为空/耗尽/冷却时回退字面量 public（匿名）。
# key：同 auto，另外允许 env/config 中的 key。
# public：强制匿名，忽略账号池。
OMNIROUTE_OPENCODE_FREE_CREDENTIAL_MODE=auto

# ---------------------------------------------------------------------------
# 本地 UTC 日预算（每个托管账号 / 匿名 public 各一份）
# ---------------------------------------------------------------------------
# 首次部署建议调高（如 10000）：让 learned_limit 从真实 429 学习真实上限。
# 调高不会让上游多给额度，只是避免网关在真 429 之前就本地自限。
OMNIROUTE_OPENCODE_FREE_DAILY_LIMIT_PER_ACCOUNT=200
OMNIROUTE_OPENCODE_FREE_DAILY_LIMIT_PUBLIC=200

# 从真实日额度 429 学习保守上限（true/false）
OMNIROUTE_OPENCODE_FREE_LEARNED_LIMIT=true

# 学到的上限在多少天没有新 429 后，按周期回升 20%（0 = 永久保留）
OMNIROUTE_OPENCODE_FREE_LEARNED_LIMIT_TTL_DAYS=7

# 已接受请求数少于此值就收到日额度 429 时，按“疑似会话准入”短冷却处理
# （0 = 关闭该判定，回到旧行为）
OMNIROUTE_OPENCODE_FREE_LEARNED_MIN_SAMPLES=10

# 疑似会话准入拒绝的短冷却秒数（不会超过上游给出的 Retry-After）
OMNIROUTE_OPENCODE_FREE_SHORT_QUOTA_COOLDOWN_SECS=60

# ---------------------------------------------------------------------------
# 并发与会话
# ---------------------------------------------------------------------------
# 单个凭据的并发上限；超出时轮换到兄弟账号或短暂等待（0 = 不限）
OMNIROUTE_OPENCODE_FREE_MAX_IN_FLIGHT_PER_ACCOUNT=2

# 新会话被长 Retry-After 拒绝时，用已接受的 warm 会话原 body 重试一次。
# 默认 false：待上游会话准入行为验证后再开。
OMNIROUTE_OPENCODE_FREE_SESSION_FALLBACK=false

# 会话 memo / warm 会话集合 / 准入状态文件名（位于 $DATA_DIR 内）
OMNIROUTE_OPENCODE_FREE_SESSION_MEMO_FILE=opencode-free-sessions.json

# ---------------------------------------------------------------------------
# 出口代理池（按出口 IP 扩容免费额度）
# ---------------------------------------------------------------------------
# 逗号分隔；每一项是一个独立的上游 IP 额度桶。支持：
#   http://[user:pass@]host:port      HTTP CONNECT；userinfo 转为
#                                     Proxy-Authorization: Basic ...
#   socks5://[user:pass@]host:port    由代理解析域名
#   socks5h://[user:pass@]host:port   由网关本地解析（与 curl 语义相反）
# 未设置 = 直连。口令中的特殊字符用 percent-encoding（例如 @ -> %40）。
# 示例（取消注释并替换占位符）：
#OMNIROUTE_OPENCODE_FREE_PROXY_POOL=http://<user>:<pass>@<proxy-host>:3128,socks5h://<user>:<pass>@<socks-host>:1080

# 单个请求最多尝试的出口数（同时受池长限制；默认 4）
OMNIROUTE_OPENCODE_FREE_MAX_PROXY_EXITS=4

# 代理/隧道失败（不可达、CONNECT 被拒、SOCKS 协商失败）出口的短冷却秒数
OMNIROUTE_OPENCODE_FREE_PROXY_COOLDOWN_SECS=30

# ---------------------------------------------------------------------------
# 名册发现（一般无需修改）
# ---------------------------------------------------------------------------
# 是否从实时目录自动发现免费名册
OMNIROUTE_OPENCODE_FREE_AUTOUPDATE=true

# 实时目录重读周期（秒，默认 12 小时）
OMNIROUTE_OPENCODE_FREE_TTL_SECONDS=43200

# ---------------------------------------------------------------------------
# 兼容旧开关（可选；等价于 CREDENTIAL_MODE=key / public，新部署不必设置）
# ---------------------------------------------------------------------------
#OMNIROUTE_OPENCODE_FREE_USE_KEY=false